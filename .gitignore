node_modules/
dist/
dist-ssr/
lib/
coverage/
*.tsbuildinfo
.DS_Store
*.log
packages/_plugins/

# Сниппеты «открыть в VS Code»: пишутся dev-сервером по запросу из браузера
packages/playground/*/scratch/

# Следы браузерного прогона vitest: вложения к отчёту и скриншоты падений —
# и то и другое он пишет сам. Появятся эталоны для toMatchScreenshot — их
# придётся вывести из-под __screenshots__, они, наоборот, коммитятся.
.vitest-attachments/
__screenshots__/

# Отчёт Playwright о последнем прогоне — пишется при каждом запуске.
test-results/

# Черновик svelte-package: сборка адаптера Svelte собирает выход здесь, копирует
# в dist и за собой не убирает. Перенести каталог можно только конфигом Svelte,
# а его у пакета нет намеренно (AGENTS.md, «Сборка пакетов»).
.svelte-kit/
