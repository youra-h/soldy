node_modules/
dist/
dist-ssr/
dist-prof/
lib/
coverage/
*.tsbuildinfo
.DS_Store
*.log
packages/_plugins/

# Сниппеты «открыть в VS Code»: пишутся dev-сервером по запросу из браузера
packages/playground/*/scratch/

# Следы прогона vitest: вложения к отчёту, скриншоты упавших браузерных тестов
# (attachments/failure-screenshots) и отчёты — всё это он пишет сам, в .vitest/
# в корне своего проекта (у браузерного прогона стенда — packages/playground/vue).
# __screenshots__ не игнорируется намеренно: сам прогон туда ничего не пишет, а
# эталоны toMatchScreenshot, которые там лягут, коммитятся.
.vitest/

# Отчёт Playwright о последнем прогоне — пишется при каждом запуске.
test-results/

# Черновик svelte-package: сборка адаптера Svelte собирает выход здесь, копирует
# в dist и за собой не убирает. Перенести каталог можно только конфигом Svelte,
# а его у пакета нет намеренно (AGENTS.md, «Сборка пакетов»).
.svelte-kit/
