{
  "name": "@soldy-ui/vue",
  "version": "0.3.0-alpha.7",
  "description": "Адаптер Vue: компоненты на headless-моделях ядра",
  "keywords": [
    "soldy",
    "headless",
    "ui",
    "components",
    "vue"
  ],
  "license": "MIT",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soldy-ui.git",
    "directory": "packages/ui/vue"
  },
  "homepage": "https://github.com/youra-h/soldy-ui",
  "bugs": {
    "url": "https://github.com/youra-h/soldy-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && vue-tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@soldy-ui/core": "0.3.0-alpha.7",
    "@soldy-ui/plugins": "0.3.0-alpha.7",
    "@soldy-ui/setup": "0.3.0-alpha.7"
  },
  "peerDependencies": {
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@soldy-ui/icons-material": "0.3.0-alpha.7",
    "@types/node": "^26.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.32",
    "vue-tsc": "^3.3.11"
  }
}
