{
  "name": "@soldy-ui/svelte",
  "version": "0.3.0-alpha.3",
  "description": "Адаптер Svelte: компоненты на headless-моделях ядра",
  "keywords": [
    "soldy",
    "headless",
    "ui",
    "components",
    "svelte"
  ],
  "license": "MIT",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soldy.git",
    "directory": "packages/ui/svelte"
  },
  "homepage": "https://github.com/youra-h/soldy",
  "bugs": {
    "url": "https://github.com/youra-h/soldy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@soldy-ui/core": "0.3.0-alpha.3",
    "@soldy-ui/plugins": "0.3.0-alpha.3",
    "@soldy-ui/setup": "0.3.0-alpha.3",
    "esm-env": "^1.2.2"
  },
  "peerDependencies": {
    "svelte": "^5.55.10"
  },
  "devDependencies": {
    "@sinonjs/fake-timers": "^15.4.0",
    "@soldy-ui/icons-material": "0.3.0-alpha.3",
    "@soldy-ui/theme-oren": "0.3.0-alpha.3",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.55.10",
    "svelte-check": "^4.7.6"
  }
}
