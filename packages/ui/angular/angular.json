{
  "$schema": "../../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "ui-angular": {
      "projectType": "library",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": []
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "ui-angular:build",
            "runner": "vitest",
            "include": ["__tests__/**/*.spec.ts"]
          }
        }
      }
    }
  }
}
