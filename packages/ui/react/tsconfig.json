{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@soldy/accessor": ["../../accessor"],
      "@soldy/accessor/*": ["../../accessor/*"],
      "@soldy/core": ["../../core/src"],
      "@soldy/core/*": ["../../core/src/*"],
      "@soldy/foundation": ["../../foundation/src"],
      "@soldy/foundation/*": ["../../foundation/src/*"],
      "@soldy/icons": ["../../icons/src"],
      "@soldy/icons/*": ["../../icons/src/*"],
      "@soldy/plugins": ["../../plugins/src"],
      "@soldy/plugins/*": ["../../plugins/src/*"],
      "@soldy/setup": ["../../setup"],
      "@soldy/setup/*": ["../../setup/*"]
    }
  },
  "include": ["env.d.ts", "src/**/*", "demo/**/*"]
}
