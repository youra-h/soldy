{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "paths": {
      "@soldy-ui/core": ["../../core/src"],
      "@soldy-ui/core/*": ["../../core/src/*"],
      "@soldy-ui/icons-material": ["../../icons/material/src"],
      "@soldy-ui/icons-material": ["../../icons/material/src"],
      "@soldy-ui/plugins": ["../../plugins/src"],
      "@soldy-ui/plugins/*": ["../../plugins/src/*"],
      "@soldy-ui/setup": ["../../setup"],
      "@soldy-ui/setup/*": ["../../setup/*"]
    }
  },
  "include": ["env.d.ts", "src/**/*"]
}
