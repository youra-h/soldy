{
  "name": "@soldy-ui/plugins",
  "version": "0.1.0",
  "description": "Плагины поведения в рантайме, ставятся в TPluginBundle: DOM, фокус, клавиатура, оверлей",
  "keywords": [
    "soldy",
    "headless",
    "ui",
    "plugins"
  ],
  "license": "MIT",
  "author": "Youra Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soldy.git",
    "directory": "packages/plugins"
  },
  "homepage": "https://github.com/youra-h/soldy",
  "bugs": {
    "url": "https://github.com/youra-h/soldy/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@soldy-ui/core": "*"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run"
