{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "noEmit": true,
    // Загрузчик конфигов Vite требует расширение в импорте плагина
    // (`./src/vite-open-in-editor.ts`), TypeScript без этого флага его
    // запрещает. Безопасно: пакет ничего не эмитит.
    "allowImportingTsExtensions": true,
    "paths": {
      "@soldy-ui/theme-oren/setup": ["../../themes/oren/setup/index.ts"],
      "@soldy-ui/theme-base/setup": ["../../themes/base/setup/index.ts"],
      "@soldy-ui/core": ["../../core/src"],
      "@soldy-ui/icons-lucide": ["../../icons/lucide/src"],
      "@soldy-ui/icons-material": ["../../icons/material/src"],
      "@soldy-ui/plugins": ["../../plugins/src"],
      "@soldy-ui/setup": ["../../setup/index.ts"],
      "@soldy-ui/vue": ["../../ui/vue/src/index.ts"],
      "@soldy-ui/webc": ["../../ui/webc/src/index.ts"],
      "@soldy-ui/playground-shared": ["../shared/src/index.ts"]
    }
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "browser/**/*",
    "browser-server/**/*",
    "styles-diff/**/*",
    "env.d.ts",
    "vite.base.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "vitest.styles.config.ts"
  ],
  // Хосты React, Svelte, Solid, Web Components и Angular — свои программы типов
  // (`src/hosts/<id>/tsconfig.json`: JSX React и Solid, `.svelte` проверяет
  // svelte-check, шаблоны Angular — ngc). Оболочка их не импортирует: грузит
  // загрузчик, ленивым glob.
  "exclude": [
    "src/hosts/react/**",
    "src/hosts/svelte/**",
    "src/hosts/solid/**",
    "src/hosts/webc/**",
    "src/hosts/angular/**"
  ]
}
