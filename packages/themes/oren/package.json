{
  "name": "@soldy-ui/theme-oren",
  "version": "0.1.0",
  "description": "Тема oren: CSS под BEM-классы и data-* компонентов Soldy UI, светлая и тёмная схемы",
  "keywords": [
    "soldy",
    "ui",
    "theme",
    "css"
  ],
  "license": "MIT",
  "author": "Youra Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soldy.git",
    "directory": "packages/themes/oren"
  },
  "homepage": "https://github.com/youra-h/soldy",
  "bugs": {
    "url": "https://github.com/youra-h/soldy/issues"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.css",
  "style": "./dist/index.css",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.css"
    },
    "./setup": {
      "types": "./dist/setup/index.d.ts",
      "default": "./dist/setup/index.js"
    }
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "npm run build:css && vite build -c vite.setup.config.ts && tsc -p tsconfig.build.json",
    "build:css": "vite build",
    "watch": "vite build --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@soldy-ui/core": "*",
    "@soldy-ui/plugins": "*",
    "@soldy-ui/setup": "*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "postcss": "^8.5.9",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.2"
  }
}
