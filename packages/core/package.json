{
  "name": "@soldy-ui/core",
  "version": "0.3.0-alpha.7",
  "description": "Headless-модели компонентов без привязки к фреймворку: компоненты, движок коллекций, фасады, расширения",
  "keywords": [
    "soldy",
    "headless",
    "ui",
    "components",
    "framework-agnostic"
  ],
  "license": "MIT AND Unicode-3.0 AND Apache-2.0",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soldy-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/youra-h/soldy-ui",
  "bugs": {
    "url": "https://github.com/youra-h/soldy-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-Unicode-3.0",
    "LICENSE-Apache-2.0"
  ],
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run"
  }
}
