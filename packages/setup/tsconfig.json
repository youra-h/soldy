{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "@soldy/core": ["../core/src"],
      "@soldy/plugins": ["../plugins/src"],
      "@soldy/accessor": ["../accessor"],
      "@soldy/accessor/*": ["../accessor/*"],
      "@soldy/setup": ["."],
      "@soldy/setup/*": ["./*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
