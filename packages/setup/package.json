{
  "name": "@soldy-ui/setup",
  "version": "0.1.0",
  "description": "Общее для всех адаптеров: дескрипторы компонентов, их сборка на монтирование и связывание с фреймворком",
  "keywords": [
    "soldy",
    "headless",
    "ui",
    "descriptors"
  ],
  "license": "MIT",
  "author": "Yuri Soldatov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youra-h/soldy.git",
    "directory": "packages/setup"
  },
  "homepage": "https://github.com/youra-h/soldy",
  "bugs": {
    "url": "https://github.com/youra-h/soldy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@soldy-ui/core": "^0.1.0",
    "@soldy-ui/plugins": "^0.1.0"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run"
  }
}
