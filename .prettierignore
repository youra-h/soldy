# Отступы и ширину строки Prettier берёт из .editorconfig: код — табы, JSON,
# YAML и Markdown — два пробела, строка до 100. В .prettierrc.json их нет
# намеренно: tabWidth оттуда перекрывал .editorconfig на всех файлах, и
# `npm run format` переписывал JSON и Markdown в четыре пробела.

# Метаданные Angular пишет генератор (npm run generate --workspace=@soldy-ui/angular),
# а CI сверяет его вывод с закоммиченным. Второго писателя у этих файлов быть не должно.
packages/ui/angular/src/generated

# Кэш сборки Angular (`npm run test:angular` пишет туда и отчёт vitest в JSON).
# Он же в .gitignore пакета; у eslint исключён в globalIgnores.
**/.angular/**

# Лок-файл пишет npm.
package-lock.json

# CHANGELOG.md пакетов пишет changesets при выпуске (npm run changeset:version).
CHANGELOG.md

# Benchmark results are written by the runners (tools/bench-pages, tools/bench-compare).
# Their nested .gitignore hides them from git, but Prettier reads only the root ignore files.
tools/bench-pages/results
tools/bench-compare/results
