{
  "name": "soldy-install-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "vite build",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''"
  },
  "devDependencies": {
    "@soldy-ui/icons-material": "*",
    "@soldy-ui/setup": "*",
    "@soldy-ui/svelte": "*",
    "@soldy-ui/theme-oren": "*",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
