{
  "name": "soldy",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/ui/*",
    "packages/themes/*",
    "packages/icons/*",
    "packages/playground/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24 || >=26"
  },
  "scripts": {
    "build": "npm run build --workspace=@soldy-ui/core && npm run build --workspace=@soldy-ui/plugins && npm run build --workspace=@soldy-ui/setup && npm run build --workspace=@soldy-ui/icons-material && npm run build --workspace=@soldy-ui/theme-oren && npm run build --workspace=@soldy-ui/vue && npm run build --workspace=@soldy-ui/react && npm run build --workspace=@soldy-ui/solid && npm run build --workspace=@soldy-ui/webc",
    "watch:theme": "npm run watch --workspace=@soldy-ui/theme-oren",
    "dev:vue": "concurrently -k -n theme,vue -c blue,green \"npm run watch:theme\" \"npm run dev --workspace=@soldy-ui/playground-vue\"",
    "test:setup": "npm run test --workspace=@soldy-ui/setup",
    "test:core": "npm run test --workspace=@soldy-ui/core",
    "test:theme": "npm run test --workspace=@soldy-ui/theme-oren",
    "test:plugins": "npm run test --workspace=@soldy-ui/plugins",
    "test:vue": "npm run test --workspace=@soldy-ui/vue",
    "test:react": "npm run test --workspace=@soldy-ui/react",
    "test:angular": "npm run test --workspace=@soldy-ui/angular",
    "test:svelte": "npm run test --workspace=@soldy-ui/svelte",
    "test:solid": "npm run test --workspace=@soldy-ui/solid",
    "test:eslint": "vitest run --root tools/eslint",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "test:webc": "npm run test --workspace=@soldy-ui/webc",
    "test:playground": "npm run test --workspace=@soldy-ui/playground-shared && npm run test --workspace=@soldy-ui/playground-vue",
    "test:layout": "npm run build:css --workspace=@soldy-ui/theme-oren && npm run test:browser --workspace=@soldy-ui/playground-vue"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@changesets/read": "^1.0.1",
    "@eslint/compat": "^2.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-vue": "~10.8.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prettier": "3.8.2",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^4.1.11",
    "vitest-browser-vue": "^3.1.0"
  }
}
